generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id
  email        String @unique
  passwordHash String
}

model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  price         Float    @default(0)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
